generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ApplicationMetadata {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
}

enum Role {
  personal
  aluno
}

enum AlunoObjective {
  hipertrofia
  emagrecimento
  condicionamento
}

enum AlunoLevel {
  iniciante
  intermediario
  avancado
}

enum AlunoStatus {
  ativo
  inativo
}

model User {
  id                Int             @id @default(autoincrement())
  email             String          @unique
  passwordHash      String
  name              String
  role              Role
  personalId        Int?
  objective         AlunoObjective?
  level             AlunoLevel?
  status            AlunoStatus?
  personal          User?           @relation("PersonalAlunos", fields: [personalId], references: [id])
  alunos            User[]          @relation("PersonalAlunos")
  createdExercises  Exercicio[]     @relation("CreatedExercises")
  authoredFichas    FichaDeTreino[] @relation("AuthoredFichas")
  assignedFichas    FichaDeTreino[] @relation("AlunoFichas")
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

model Exercicio {
  id                  Int                @id @default(autoincrement())
  name                String
  muscleGroup         String
  description         String             @default("")
  defaultSets         Int                @default(3)
  defaultReps         String             @default("8 a 12")
  level               AlunoLevel         @default(iniciante)
  createdByPersonalId Int
  createdByPersonal   User               @relation("CreatedExercises", fields: [createdByPersonalId], references: [id])
  treinoExercicios    TreinoExercicio[]
}

model FichaDeTreino {
  id        Int      @id @default(autoincrement())
  alunoId   Int
  personalId Int
  title     String
  aluno     User     @relation("AlunoFichas", fields: [alunoId], references: [id])
  personal  User     @relation("AuthoredFichas", fields: [personalId], references: [id])
  treinos   Treino[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Treino {
  id                 Int                @id @default(autoincrement())
  fichaId            Int
  name               String
  order              Int
  completedAt        DateTime?
  ficha              FichaDeTreino      @relation(fields: [fichaId], references: [id])
  treinoExercicios   TreinoExercicio[]

  @@unique([fichaId, order])
}

model TreinoExercicio {
  treinoId   Int
  exercicioId Int
  sets       Int
  reps       Int
  treino     Treino    @relation(fields: [treinoId], references: [id])
  exercicio  Exercicio @relation(fields: [exercicioId], references: [id])

  @@id([treinoId, exercicioId])
}
