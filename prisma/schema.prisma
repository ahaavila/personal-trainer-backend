generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ApplicationMetadata {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
}

enum Role {
  personal
  aluno
}

enum AlunoObjective {
  hipertrofia
  emagrecimento
  condicionamento
}

enum AlunoLevel {
  iniciante
  intermediario
  avancado
}

enum AlunoStatus {
  ativo
  inativo
}

enum SubscriptionPlan {
  basic
  pro
}

enum SubscriptionStatus {
  active
  past_due
  canceled
  trialing
  unpaid
}

enum ExerciseMediaKind {
  photo
  video
}

model User {
  id                Int             @id @default(autoincrement())
  email             String          @unique
  passwordHash      String
  name              String
  role              Role
  avatarUrl         String?
  plan              SubscriptionPlan   @default(basic)
  subscriptionStatus SubscriptionStatus? @default(active)
  stripeCustomerId  String?            @unique
  stripeSubscriptionId String?
  currentPeriodEnd  DateTime?
  personalId        Int?
  objective         AlunoObjective?
  level             AlunoLevel?
  status            AlunoStatus?
  personal          User?           @relation("PersonalAlunos", fields: [personalId], references: [id])
  alunos            User[]          @relation("PersonalAlunos")
  createdExercises  Exercicio[]     @relation("CreatedExercises")
  authoredFichas    FichaDeTreino[] @relation("AuthoredFichas")
  assignedFichas    FichaDeTreino[] @relation("AlunoFichas")
  passwordResetTokens PasswordResetToken[]
  treinoExecucoes   TreinoExecucao[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Exercicio {
  id                  Int                @id @default(autoincrement())
  name                String
  muscleGroup         String
  equipment           String?
  description         String             @default("")
  defaultSets         Int                @default(3)
  defaultReps         String             @default("8 a 12")
  level               AlunoLevel         @default(iniciante)
  createdByPersonalId Int
  createdByPersonal   User               @relation("CreatedExercises", fields: [createdByPersonalId], references: [id])
  treinoExercicios    TreinoExercicio[]
  media               ExerciseMedia[]
  execucoes           ExercicioExecucaoLog[]
}

model ExerciseMedia {
  id          Int               @id @default(autoincrement())
  exercicioId Int
  kind        ExerciseMediaKind
  objectKey   String
  contentType String
  byteSize    Int
  createdAt   DateTime          @default(now())
  exercicio   Exercicio         @relation(fields: [exercicioId], references: [id], onDelete: Cascade)

  @@unique([exercicioId, kind])
}

model FichaDeTreino {
  id        Int      @id @default(autoincrement())
  alunoId   Int
  personalId Int
  title     String
  notes     String?
  startDate DateTime?
  endDate   DateTime?
  status    String   @default("active")
  aluno     User     @relation("AlunoFichas", fields: [alunoId], references: [id])
  personal  User     @relation("AuthoredFichas", fields: [personalId], references: [id])
  treinos   Treino[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Treino {
  id               Int                @id @default(autoincrement())
  fichaId          Int
  name             String
  order            Int
  notes            String?
  completedAt      DateTime?
  ficha            FichaDeTreino      @relation(fields: [fichaId], references: [id], onDelete: Cascade)
  treinoExercicios TreinoExercicio[]
  execucoes        TreinoExecucao[]

  @@unique([fichaId, order])
}

model TreinoExercicio {
  id           Int       @id @default(autoincrement())
  treinoId     Int
  exercicioId  Int
  order        Int       @default(1)
  sets         Int
  reps         String
  restInterval String?
  targetLoad   String?
  notes        String?
  treino       Treino    @relation(fields: [treinoId], references: [id], onDelete: Cascade)
  exercicio    Exercicio @relation(fields: [exercicioId], references: [id])

  @@unique([treinoId, order])
}

model TreinoExecucao {
  id          Int                    @id @default(autoincrement())
  alunoId     Int
  treinoId    Int?
  title       String
  startedAt   DateTime
  completedAt DateTime
  durationMin Int?
  notes       String?
  aluno       User                   @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  treino      Treino?                @relation(fields: [treinoId], references: [id], onDelete: SetNull)
  exercicios  ExercicioExecucaoLog[]
  createdAt   DateTime               @default(now())

  @@index([alunoId])
  @@index([completedAt])
}

model ExercicioExecucaoLog {
  id               Int            @id @default(autoincrement())
  treinoExecucaoId Int
  exercicioId      Int
  order            Int            @default(1)
  setsCompleted    Int
  repsCompleted    String
  maxWeightKg      Float
  notes            String?
  treinoExecucao   TreinoExecucao @relation(fields: [treinoExecucaoId], references: [id], onDelete: Cascade)
  exercicio        Exercicio      @relation(fields: [exercicioId], references: [id], onDelete: Cascade)
  createdAt        DateTime       @default(now())

  @@index([treinoExecucaoId])
  @@index([exercicioId])
}
