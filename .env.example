# PostgreSQL connection for local development (provided by docker-compose.yml).
DATABASE_URL="postgresql://personal_trainer:personal_trainer@localhost:5432/personal_trainer?schema=public"

# HTTP port used by the NestJS application.
PORT=3000

# JWT signing configuration. Use a unique secret outside local development.
JWT_SECRET="change-this-secret-in-production"
JWT_EXPIRES_IN="1h"

# Comma-separated frontend origins permitted by the browser CORS policy.
CORS_ORIGIN="http://localhost:5173"
